# Server-only PostgreSQL connection (use a Neon pooled connection string in Vercel)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Comma-separated browser origins permitted to call the API.
CORS_ORIGIN=
PORT=

# Only set when deliberately deploying the API on a different origin.
VITE_API_URL=

# AI interpretation is optional. Default behavior uses a deterministic mock
# interpreter that proposes the seeded Montreal allocation.
AI_PROVIDER=mock
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
# Optional for slow local models: AI_REQUEST_TIMEOUT_MS=180000
# Optional for LM Studio Qwen non-reasoning output: AI_DISABLE_THINKING=1
# Muse Ember development: AI_PROVIDER=openai-compatible, AI_BASE_URL=https://api.meta.ai/v1,
# AI_MODEL=muse-ember-1.0, AI_REASONING_EFFORT=minimal, AI_REQUEST_TIMEOUT_MS=20000.
# Set AI_API_KEY only in ignored .env.local. For local Qwen, restore its localhost URL/model/key.

# PayPal Standard Checkout is optional. Default is mock; it does not move money.
# Sandbox Orders has one buyer/merchant order, not WHOOSH multi-payer settlement.
PAYPAL_MODE=mock
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Sandbox Business account merchant ID; required for independent share verification.
PAYPAL_MERCHANT_ID=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Browser origin used exclusively for PayPal's approved/cancelled return URLs.
# Use http://localhost:5173 in local Vite development and your HTTPS web URL in deployment.
PAYPAL_RETURN_ORIGIN=http://localhost:5173

# Optional server-only speech-to-text. Leave blank to keep typed input working.
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v2
VOICE_TRANSCRIPTION_ENABLED=false
